{
  "name": "string-client",
  "version": "1.0.0",
  "description": "String Client - Lightweight Minecraft Launcher with Custom Chat",
  "main": "main.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "electron:dev": "concurrently \"vite\" \"wait-on http://localhost:5173 && electron .\"",
    "electron:build": "vite build && electron-builder",
    "electron:build:portable": "vite build && electron-builder --win portable --config.compression=store",
    "electron:build:all": "vite build && electron-builder --win",
    "start": "electron .",
    "server": "node server/index.js",
    "server:dev": "node --watch server/index.js",
    "bot": "node server/discord-bot.js",
    "bot:dev": "node --watch server/discord-bot.js",
    "build:zip": "powershell -NoProfile -Command \"if (Test-Path launcher-build.zip) { Remove-Item launcher-build.zip }; Compress-Archive -Path main.js,preload.js,auth-main.js,package.json,dist,buildResources -DestinationPath launcher-build.zip -Force\"",
    "deploy:launcher": "powershell -NoProfile -Command \"$url='https://stringclient.com/api/admin/launcher/upload'; $zip=[System.IO.File]::ReadAllBytes('launcher-build.zip'); $wc=New-Object System.Net.WebClient; $wc.Headers.Add('Content-Type','application/zip'); $wc.Headers.Add('x-admin-token','$env:BOT_TOKEN'); $wc.UploadData($url,'POST',$zip)\""
  },
  "author": "String Client",
  "build": {
    "appId": "com.stringclient.launcher",
    "productName": "String Client",
    "author": "String Client",
    "copyright": "Copyright © 2025 String Client",
    "files": [
      "main.js",
      "preload.js",
      "auth-main.js",
      "package.json",
      "dist/**/*",
      "buildResources/icon-256.png"
    ],
    "win": {
      "target": "nsis",
      "icon": "buildResources/icon.ico",
      "signAndEditExecutable": false,
      "publisherName": "String Client",
      "companyName": "String Client"
    },
    "nsis": {
        "oneClick": false,
        "perMachine": false,
        "allowToChangeInstallationDirectory": true,
        "installerIcon": "buildResources/icon.ico",
        "uninstallerIcon": "buildResources/icon.ico",
        "installerHeaderIcon": "buildResources/icon.ico",
      "installerSidebar": "buildResources/installerSidebar.bmp",
      "installerHeader": "buildResources/installerHeader.bmp",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "String Client",
      "unicode": true,
      "installerLanguages": [
        "en_US"
      ],
      "language": "1049",
      "include": "buildResources/installer.nsh",
      "runAfterFinish": false
    }
  },
  "dependencies": {
    "discord-rpc": "^4.0.1",
    "discord.js": "^14.27.0",
    "dotenv": "^16.4.0",
    "electron": "^28.1.0",
    "jose": "^4.15.5",
    "minecraft-launcher-core": "^3.2.1",
    "sharp": "^0.35.3",
    "skinview3d": "^3.4.2",
    "smart-buffer": "^4.2.0",
    "ws": "^8.21.1"
  },
  "devDependencies": {
    "@types/react": "^18.2.48",
    "@types/react-dom": "^18.2.18",
    "@vitejs/plugin-react": "^4.2.1",
    "concurrently": "^8.2.2",
    "electron-builder": "^24.9.1",
    "png-to-ico": "^3.0.2",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "typescript": "^5.3.3",
    "vite": "^5.0.12",
    "wait-on": "^7.2.0"
  }
}
