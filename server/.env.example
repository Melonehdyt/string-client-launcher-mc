# The token the Discord bot sends to authenticate news POST/DELETE requests
# Can be any string — keep it secret from launcher users
BOT_TOKEN=discord-bot-secret-2024

# Your Discord bot token from https://discord.com/developers/applications
DISCORD_BOT_TOKEN=your-discord-bot-token-here

# Server port (default 3001)
PORT=3001

# API base URL (use public URL if bot is on a different machine)
API_URL=http://localhost:3001

# Discord channel ID where news are auto-posted (optional)
NEWS_CHANNEL_ID=
