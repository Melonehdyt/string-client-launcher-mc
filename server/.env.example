# The token the Discord bot sends to authenticate news POST/DELETE requests
# Can be any string — keep it secret from launcher users
BOT_TOKEN=discord-bot-secret-2024

# Your Discord bot token from https://discord.com/developers/applications
DISCORD_BOT_TOKEN=your-discord-bot-token-here

# Server port (default 3001)
PORT=3001

# API base URL (use public URL if bot is on a different machine)
API_URL=http://localhost:3001

# Discord channel ID where news are auto-posted (optional)
NEWS_CHANNEL_ID=

# Discord OAuth2 for admin panel
# Create an app at https://discord.com/developers/applications, add redirect URI: ${API_URL}/api/admin/auth/callback
DISCORD_CLIENT_ID=your-discord-client-id
DISCORD_CLIENT_SECRET=your-discord-client-secret
ADMIN_DISCORD_GUILD_ID=your-guild-id
# Optional: override guild ID for Lanyard presence tracking (defaults to ADMIN_DISCORD_GUILD_ID)
LANYARD_GUILD_ID=
# Comma-separated list of role IDs that can access admin panel (blank = any guild member)
ADMIN_DISCORD_ROLE_IDS=

# Optional: password fallback for admin panel (used if Discord OAuth2 is not set up)
ADMIN_PASSWORD=

# Comma-separated list of Discord role IDs that can assign the "Owner" role in admin panel
# Only members with one of these roles can promote a player to Owner (regular admins cannot)
# Leave blank to allow any admin to assign Owner (not recommended)
OWNER_DISCORD_ROLE_IDS=1506634520017764493,
