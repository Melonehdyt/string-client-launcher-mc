# API security — the token the Discord bot sends to authenticate POST/DELETE
# BOT_TOKEN=
BOT_TOKEN=
# Discord bot token — from https://discord.com/developers/applications
DISCORD_BOT_TOKEN=


# Server port
PORT=3000

# API base URL (change if not localhost)
API_URL=https://stringclient.com

# Discord channel ID where news are auto-posted
NEWS_CHANNEL_ID=1513509644595626135

# Discord OAuth2 for admin panel — create an app at https://discord.com/developers/applications
DISCORD_CLIENT_ID=1524140283359531178
DISCORD_CLIENT_SECRET=in-r9s3PWSbqonHJDC4LkDE1yzp38u8N
ADMIN_DISCORD_GUILD_ID=1506631299937599518
ADMIN_DISCORD_ROLE_IDS=1525047958553366600,1524856161697005598,1506634520017764493,1506634289381380
# Optional: password fallback for admin panel (used if Discord OAuth2 isn't set up)
ADMIN_PASSWORD=admin123

# Comma-separated list of Discord role IDs that can assign the "Owner" role in admin panel
# Only members with one of these roles can promote a player to Owner (regular admins cannot)
# Leave blank to allow any admin to assign Owner (not recommended)
OWNER_DISCORD_ROLE_IDS=
